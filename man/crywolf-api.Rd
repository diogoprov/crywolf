\section{Experimental functions}{

\code{\link[=fp_occu_mc]{fp_occu_mc()}}, \code{\link[=fp_draws_data]{fp_draws_data()}} and \code{\link[=fp_to_unmarked]{fp_to_unmarked()}}, with the
